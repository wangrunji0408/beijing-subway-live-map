# Timetable poster images are large binaries -> keep them in Git LFS.
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text

# Data files (JSONL/JSON) are large and change wholesale on every rebuild ->
# keep them in Git LFS as well.
*.jsonl filter=lfs diff=lfs merge=lfs -text
output/*.json filter=lfs diff=lfs merge=lfs -text
web/data/*.json filter=lfs diff=lfs merge=lfs -text
